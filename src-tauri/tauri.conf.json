{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Focus Simulator",
  "version": "1.0.0",
  "identifier": "app.focussimulator.tauri",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "node tools/build.mjs --watch",
    "beforeBuildCommand": "node tools/build.mjs"
  },
  "app": {
    "windows": [
      {
        "title": "Focus Simulator",
        "width": 460,
        "height": 900,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "backgroundColor": "#0b1220"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
