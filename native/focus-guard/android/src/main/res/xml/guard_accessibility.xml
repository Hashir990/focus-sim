<?xml version="1.0" encoding="utf-8"?>
<!-- **What this service is allowed to see, and why each part is here.**

     `typeWindowStateChanged` is which app came to the front, and it is the whole
     of app blocking.

     `typeWindowContentChanged` with `canRetrieveWindowContent` and
     `flagReportViewIds` is website blocking and the lock. A browser's address bar
     is found by its view id and read, and only while a rule blocks a website; a
     Settings screen's words are looked at only while the lock is on, to recognise
     the few screens that would switch the blocker off. BlockService ignores
     content from every other app before reading anything — the check is its
     first line — and it stores nothing but a host name and seconds.

     This used to be the first event type alone with no content flags, and said
     so. Website blocking cannot be done that way, so it is no longer true, and
     the description Android shows before the switch is thrown (strings.xml) was
     changed to say exactly what is read instead.

     `packageNames` is left off on purpose. Naming the blocked apps here would be
     the tighter setting, but the list is chosen at runtime and this file is baked
     into the APK - so the filtering happens in BlockService instead. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagReportViewIds"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="100"
    android:description="@string/guard_service_desc" />
