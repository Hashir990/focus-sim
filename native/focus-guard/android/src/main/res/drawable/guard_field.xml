<?xml version="1.0" encoding="utf-8"?>
<!-- The answer box for the shield's small task. Filled rather than outlined, so it
     reads as a place to type rather than as a third button. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/guard_card" />
    <stroke android:width="1dp" android:color="#33FFFFFF" />
    <corners android:radius="12dp" />
    <padding android:left="14dp" android:right="14dp" android:top="12dp" android:bottom="12dp" />
</shape>
