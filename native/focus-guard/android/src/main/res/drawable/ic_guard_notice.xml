<?xml version="1.0" encoding="utf-8"?>
<!-- A notification's small icon is drawn as a silhouette: Android throws the
     colours away and keeps the alpha, so anything with a fill and a stroke of
     different colours comes out as one flat blob. This is the app's ring with a
     hole punched through it by fillType="evenOdd", plus the hand, so the shape
     survives being reduced to a stencil. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M12,2 A10,10 0 1,0 12,22 A10,10 0 1,0 12,2 Z M12,4.6 A7.4,7.4 0 1,1 12,19.4 A7.4,7.4 0 1,1 12,4.6 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.1,6.6 h1.8 v6.1 h-1.8 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M11.1,11.6 h4.7 v1.8 h-4.7 Z" />
</vector>
