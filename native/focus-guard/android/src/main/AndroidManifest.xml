<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Posting anything at all. A refusal is a working state: the app carries
         on and simply never says anything from outside itself. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- **This is what makes the shield possible, and it is not for drawing.**
         Since Android 10 a background app may not start an activity — which is
         exactly what an accessibility service noticing Instagram has to do.
         Holding SYSTEM_ALERT_WINDOW is one of the few exemptions, so the
         "Display over other apps" switch is not a nicety here, it is the
         mechanism. Nothing in this plugin ever adds a window to WindowManager. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- The end of a block has to announce itself from a pocket, so it is handed
         to AlarmManager up front rather than waiting for a frozen web view to
         notice. USE_EXACT_ALARM is granted at install to alarm-and-timer apps;
         SCHEDULE_EXACT_ALARM is the older, revocable form and is the fallback. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Grayscale while something blocked is in front. A protected permission:
         declaring it does nothing on its own, and it is only ever granted over
         adb (see ANDROID.md). Without the grant the page says grayscale is
         unavailable and BlockService never tries. -->
    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- **A `queries` block, not QUERY_ALL_PACKAGES.** The picker only ever
         wants apps a person can launch, and that is precisely what this
         declares. The blanket permission would list background services and
         input methods nobody can open, and it is the one Play asks you to
         justify in writing. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application>
        <!-- Its own task, and out of Recents. The shield stands in front of an
             app you asked to be stopped from opening; leaving a card for it in
             the recents list is leaving a way straight back past it. -->
        <activity
            android:name="app.focussimulator.guard.ShieldActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:taskAffinity="app.focussimulator.guard.shield"
            android:theme="@style/GuardShield"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode" />

        <receiver
            android:name="app.focussimulator.guard.NoticeReceiver"
            android:exported="false" />

        <!-- Device admin with no policies, so uninstalling takes two steps while
             the lock is on. See GuardAdmin.java. -->
        <receiver
            android:name="app.focussimulator.guard.GuardAdmin"
            android:exported="true"
            android:label="@string/guard_admin_label"
            android:description="@string/guard_admin_desc"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/guard_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name="app.focussimulator.guard.BlockService"
            android:exported="false"
            android:label="@string/guard_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/guard_accessibility" />
        </service>
    </application>
</manifest>
