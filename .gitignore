node_modules/
dist/
release/
release-fix/

# The full-length source recordings (hundreds of MB). Keep them locally; the
# one-hour cuts in dist/audio are produced from them by tools/encode-audio.sh.
*.mp3
audio-src/
!src/**/*.mp3

# The iOS project is still generated: there is none in here, and nothing has
# been built for it. The Android one is tracked instead, because a signed store
# upload has to be reproducible from a clone - see android/.gitignore, which
# Capacitor writes, for the generated parts that stay out of it.
ios/

# The upload key. Never in the repository, on any branch, ever.
android/keystore.properties
android/play-key.json
*.jks
*.keystore

# What tools/look-*.mjs render. Generated pictures and the spliced copies of
# the bundle they are rendered from — never source, and some of them are large.
look/

# Tauri
src-tauri/target/
src-tauri/gen/

.env
.env.local
.DS_Store
Thumbs.db
*.log
npm-debug.log*
.idea/
.vscode/
tools/slice-run.mjs

Google Play assets/
