# Read by tools/build.mjs. Baked into every build made from here on, so the
# copies you hand out know where to check. See INSTALL.md.
FOCUS_UPDATE_URL=https://github.com/Hashir990/focus-sim/releases/latest/download/latest.json
FOCUS_RELEASE_URL=https://github.com/Hashir990/focus-sim/releases/latest
# Turns on sign-in and cross-device sync. Every build made from here on has it;
# with this line removed the app has no account, makes no request, and says so
# in the menu. See ACCOUNTS.md.
FOCUS_ACCOUNT_URL=https://focus-accounts.focus-accounts.workers.dev

# Named in the privacy policy as whoever runs the app, in all seven languages.
# The law wants a person behind a policy, so this is the one value in here that
# publish-check refuses to let a release go out without.
FOCUS_PRIVACY_OWNER=Hashir N.
